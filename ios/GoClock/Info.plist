<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Everything else in this app's Info.plist is generated from the build
	  settings (GENERATE_INFOPLIST_FILE), and the generated keys are merged
	  into this file rather than replacing it. Only what has no
	  INFOPLIST_KEY_ lives here.

	  The launch screen: a plain window in the same grey as the page's
	  background (LaunchBackground in the asset catalog), so the app opens
	  onto the board without a white flash first.
	-->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
